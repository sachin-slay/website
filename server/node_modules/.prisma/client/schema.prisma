datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  dob                DateTime?
  age                Int?
  gender             String
  city               String
  relationshipStatus String?
  marriageTimeline   String?
  userRelation       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lifestyle Lifestyle?
  matches   Match[]
}

model Lifestyle {
  id             String   @id @default(uuid())
  userId         String?  @unique
  prospectId     String?  @unique
  activityLevel  String
  dailySteps     Int
  occupation     String
  workStyle      String
  drinkingHabit  String
  smokingHabit   String
  tobaccoHabit   String
  sleepPattern   String
  heightValue    Float
  heightUnit     String   @default("cm")
  weightValue    Float
  weightUnit     String   @default("kg")
  waistValue     Float
  waistUnit      String   @default("in")
  menstrualCycle String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
}

model Prospect {
  id            String    @id @default(uuid())
  name          String
  dob           DateTime?
  age           Int?
  gender        String
  city          String
  meetingSource String
  platformName  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lifestyle Lifestyle?
  matches   Match[]
}

model Match {
  id         String   @id @default(uuid())
  userId     String
  prospectId String
  score      Int?
  status     String   @default("pending") // pending | ready | in-progress
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  reports  Report[]
}

model Report {
  id           String   @id @default(uuid())
  matchId      String
  category     String // pathology | radiology | genetic | mentalHealth | lifestyle
  userUploaded Boolean  @default(false)
  prosUploaded Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, category])
}
